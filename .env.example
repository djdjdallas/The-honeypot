# ============================================================
# HoneyTrap — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.

# --- AWS Bedrock (for Amazon Nova) ---
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_REGION=us-east-1

# --- Telegram (from https://my.telegram.org) ---
TELEGRAM_API_ID=your_api_id
TELEGRAM_API_HASH=your_api_hash

# Session string (REQUIRED for production/Lambda).
# Generate with: python scripts/generate_session.py
# This replaces phone-based auth — no stdin needed at runtime.
TELEGRAM_SESSION_STRING=

# Phone number (only needed for local dev if no session string).
# Not used in production.
TELEGRAM_PHONE=+1234567890

# --- Supabase ---
SUPABASE_URL=https://hphcyxwhchgqytrayama.supabase.co
SUPABASE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImhwaGN5eHdoY2hncXl0cmF5YW1hIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzIzOTM1NDEsImV4cCI6MjA4Nzk2OTU0MX0.Cpdf_VrL4rugwPRWY-vz9_sxAMTpQnEx_oe6s2ysi7s
# --- Agent Behavior ---
MAX_TURNS_PER_SESSION=20
MAX_CONCURRENT_SESSIONS=3
NEW_SESSION_COOLDOWN=30.0

# --- Target Groups (fallback if groups.yaml not present) ---
# Comma-separated Telegram group usernames or IDs.
MONITOR_GROUPS=
